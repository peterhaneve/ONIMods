msgid "The completed {0} will melt at <b>{1}</b> into {2}"
msgstr "El {0} completado se derretirá a <b>{1}</b> convirtiéndose en {2}"

#. PeterHan.ThermalTooltips.ThermalTooltipsStrings.UI.THERMALTOOLTIPS.BUILDING_THERMAL_MASS
msgctxt "PeterHan.ThermalTooltips.ThermalTooltipsStrings.UI.THERMALTOOLTIPS.BUILDING_THERMAL_MASS"
msgid ""
"The completed {0} will have a thermal mass of <b>{1:##0.#} {2}/{3}</b>\n"
"\n"
"Adding or removing {1:##0.#} {2} will change the building's <link=\"HEAT\">Temperature</link> by 1 {3}"
msgstr ""
"El {0} completado tendrá una masa térmica de <b>{1:##0.#} {2}/{3}</b>\n"
"\n"
"Añadir o quitar {1:##0.#} {2} cambiará la <link=\"HEAT\">Temperatura</link> del edificio en 1 {3}"

