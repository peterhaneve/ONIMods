msgstr "调整复制人下一个任务的优先级。"

#. PeterHan.FastTrack.FastTrackStrings.UI.TOOLTIPS.FASTTRACK.CLUSTERMAPQUALITY
msgctxt "PeterHan.FastTrack.FastTrackStrings.UI.TOOLTIPS.FASTTRACK.CLUSTERMAPQUALITY"
msgid ""
"Slightly reduce the graphics quality of the Spaced Out! Starmap\n"
"in exchange for a significant performance boost.\n"
"\n"
"<b>Performance Impact: <color=#FF3300>High</color></b>"
msgstr ""
"略微降低《眼冒金星!》星图的画质，以换取显著的性能提升。\n"
"\n"
"<b>性能影响：<color=#FF3300>高</color></b>"

#. PeterHan.FastTrack.FastTrackStrings.UI.TOOLTIPS.FASTTRACK.CONDUITOPTS
msgctxt "PeterHan.FastTrack.FastTrackStrings.UI.TOOLTIPS.FASTTRACK.CONDUITOPTS"
msgid ""
"Multi-threads some updates to liquid and gas conduits.\n"
"\n"
"<b>Performance Impact: <color=#00CC00>Low</color></b>"
msgstr ""
"将部分液体和气体管道的更新操作多线程处理。\n"
"\n"
"<b>性能影响：<color=#00CC00>低</color></b>"

#. PeterHan.FastTrack.FastTrackStrings.UI.TOOLTIPS.FASTTRACK.CRITTERCONSUMERS
msgctxt "PeterHan.FastTrack.FastTrackStrings.UI.TOOLTIPS.FASTTRACK.CRITTERCONSUMERS"
msgid ""
"Optimize how Critters find objects to eat.\n"
"\n"
"<b>Performance Impact: <color=#00CC00>Low</color></b>"
msgstr ""
"优化小动物寻找食物的方式。\n"
"\n"
"<b>性能影响：<color=#00CC00>低</color></b>"

#. PeterHan.FastTrack.FastTrackStrings.UI.TOOLTIPS.FASTTRACK.CULLCONDUITS
msgctxt "PeterHan.FastTrack.FastTrackStrings.UI.TOOLTIPS.FASTTRACK.CULLCONDUITS"
msgid ""
"Hide conduits and wires inside solid walls.\n"
"\n"
"<b>Performance Impact: <color=#00CC00>Low</color></b>"
msgstr ""
"隐藏实体墙内的管道和电线。\n"
"\n"
"<b>性能影响：<color=#00CC00>低</color></b>"

#. PeterHan.FastTrack.FastTrackStrings.UI.TOOLTIPS.FASTTRACK.CUSTOMSTRINGFORMAT
msgctxt "PeterHan.FastTrack.FastTrackStrings.UI.TOOLTIPS.FASTTRACK.CUSTOMSTRINGFORMAT"
msgid ""
"Reduces memory allocations when formatting strings.\n"
"<i>Not compatible with mods: DisplayAllTemps</i>\n"
"\n"
"<b>Performance Impact: <color=#FF8827>Medium</color></b>"
msgstr ""
"减少格式化字符串时的内存分配。\n"
"<i>与 Mod “DisplayAllTemps” 不兼容</i>\n"
"\n"
"<b>性能影响：<color=#FF8827>中</color></b>"

#. PeterHan.FastTrack.FastTrackStrings.UI.TOOLTIPS.FASTTRACK.DISABLEACHIEVEMENTS
msgctxt "PeterHan.FastTrack.FastTrackStrings.UI.TOOLTIPS.FASTTRACK.DISABLEACHIEVEMENTS"
msgid ""
"Turn off checking for Colony Initiatives.\n"
"<color=#FF0000>Disabling will prevent unlocking any Steam achievement</color>\n"
"\n"
"<b>Performance Impact: <color=#00CC00>Low</color></b>"
msgstr ""
"关闭殖民地任务检测。\n"
"<color=#FF0000>关闭后将无法解锁任何 Steam 成就</color>\n"
"\n"
"<b>性能影响：<color=#00CC00>低</color></b>"

#. PeterHan.FastTrack.FastTrackStrings.UI.TOOLTIPS.FASTTRACK.DISABLECONDUITANIMATION
msgctxt "PeterHan.FastTrack.FastTrackStrings.UI.TOOLTIPS.FASTTRACK.DISABLECONDUITANIMATION"
msgid ""
"Controls the visual fidelity of pipe animations.\n"
"<i>No changes to actual pipe mechanics will occur</i>\n"
"\n"
"<b>Performance Impact: <color=#FF8827>Medium</color></b>"
msgstr ""
"控制管道动画的视觉精细度。\n"
"<i>不会影响管道的实际机制</i>\n"
"\n"
"<b>性能影响：<color=#FF8827>中</color></b>"

#. PeterHan.FastTrack.FastTrackStrings.UI.TOOLTIPS.FASTTRACK.DISABLELOADPREVIEWS
msgctxt "PeterHan.FastTrack.FastTrackStrings.UI.TOOLTIPS.FASTTRACK.DISABLELOADPREVIEWS"
msgid ""
"Disables loading of colony previews on the Load screen.\n"
"\n"
"<b>Performance Impact: <color=#FF8827>Medium</color></b>"
msgstr ""
"禁用在加载界面显示殖民地预览。\n"
"\n"
"<b>性能影响：<color=#FF8827>中</color></b>"

#. PeterHan.FastTrack.FastTrackStrings.UI.TOOLTIPS.FASTTRACK.DISABLESOUND
msgctxt "PeterHan.FastTrack.FastTrackStrings.UI.TOOLTIPS.FASTTRACK.DISABLESOUND"
msgid ""
"Completely disables <color=#FF0000>all</color> sound playback.\n"
"\n"
"<b>Performance Impact: <color=#00CC00>Low</color></b>"
msgstr ""
"完全禁用<color=#FF0000>所有</color>音效播放。\n"
"\n"
"<b>性能影响：<color=#00CC00>低</color></b>"

#. PeterHan.FastTrack.FastTrackStrings.UI.TOOLTIPS.FASTTRACK.DISABLETUTORIAL
msgctxt "PeterHan.FastTrack.FastTrackStrings.UI.TOOLTIPS.FASTTRACK.DISABLETUTORIAL"
msgid ""
"Disables tutorial messages.\n"
"\n"
"<b>Performance Impact: <color=#00CC00>Low</color></b>"
msgstr ""
"禁用教程提示信息。\n"
"\n"
"<b>性能影响：<color=#00CC00>低</color></b>"

#. PeterHan.FastTrack.FastTrackStrings.UI.TOOLTIPS.FASTTRACK.ENETOPTS
msgctxt "PeterHan.FastTrack.FastTrackStrings.UI.TOOLTIPS.FASTTRACK.ENETOPTS"
msgid ""
"Speeds up calculations of electrical networks.\n"
"\n"
"<i>Not compatible with mods: Giga-Watt Wire</i>\n"
"\n"
"<b>Performance Impact: <color=#FF8827>Medium</color></b>"
msgstr ""
"加快电力网络计算速度。\n"
"\n"
"<i>与 Mod “Giga-Watt Wire” 不兼容</i>\n"
"\n"
"<b>性能影响：<color=#FF8827>中</color></b>"

#. PeterHan.FastTrack.FastTrackStrings.UI.TOOLTIPS.FASTTRACK.FASTATTRIBUTESMODE
msgctxt "PeterHan.FastTrack.FastTrackStrings.UI.TOOLTIPS.FASTTRACK.FASTATTRIBUTESMODE"
msgid ""
"Optimize attribute leveling and work efficiency calculation.\n"
"\n"
"<b>Performance Impact: <color=#FF8827>Medium</color></b>"
msgstr ""
"优化属性升级和工作效率计算。\n"
"\n"
"<b>性能影响：<color=#FF8827>中</color></b>"

#. PeterHan.FastTrack.FastTrackStrings.UI.TOOLTIPS.FASTTRACK.FASTREACHABILITY
msgctxt "PeterHan.FastTrack.FastTrackStrings.UI.TOOLTIPS.FASTTRACK.FASTREACHABILITY"
msgid ""
"Only check items and chores for reachability when necessary.\n"
"\n"
"<b>Performance Impact: <color=#FF8827>Medium</color></b>"
msgstr ""
"仅在必要时检查物品和任务的可达性。\n"
"\n"
"<b>性能影响：<color=#FF8827>中</color></b>"

#. PeterHan.FastTrack.FastTrackStrings.UI.TOOLTIPS.FASTTRACK.FASTSTRUCTURETEMPERATURE
msgctxt "PeterHan.FastTrack.FastTrackStrings.UI.TOOLTIPS.FASTTRACK.FASTSTRUCTURETEMPERATURE"
msgid ""
"Reduces memory allocations used when generating heat.\n"
"\n"
"<b>Performance Impact: <color=#FF8827>Medium</color></b>"
msgstr ""
"<b>性能影响：<color=#FF8827>中</color></b>\n"
"\n"
"<b>性能影响：<color=#FF8827>中</color></b>"

#. PeterHan.FastTrack.FastTrackStrings.UI.TOOLTIPS.FASTTRACK.FASTUPDATEPICKUPS
msgctxt "PeterHan.FastTrack.FastTrackStrings.UI.TOOLTIPS.FASTTRACK.FASTUPDATEPICKUPS"
msgid ""
"Speed up inefficient and memory-intensive checks for items.\n"
"<i>Not compatible with mods: Efficient Supply</i>\n"
"\n"
"<b>Performance Impact: <color=#00CC00>Low</color></b>"
msgstr ""
"加快对物品进行低效且占用大量内存的检查。\n"
"<i>与 Mod “Efficient Supply” 不兼容</i>\n"
"\n"
"<b>性能影响：<color=#00CC00>低</color></b>"

#. PeterHan.FastTrack.FastTrackStrings.UI.TOOLTIPS.FASTTRACK.FLATTENAVERAGES
msgctxt "PeterHan.FastTrack.FastTrackStrings.UI.TOOLTIPS.FASTTRACK.FLATTENAVERAGES"
msgid ""
"Optimize Amounts and average calculations.\n"
"\n"
"<b>Performance Impact: <color=#00CC00>Low</color></b>"
msgstr ""
"优化数量和平均值计算。\n"
"\n"
"<b>性能影响：<color=#00CC00>低</color></b>"

#. PeterHan.FastTrack.FastTrackStrings.UI.TOOLTIPS.FASTTRACK.INFOCARDOPTS
msgctxt "PeterHan.FastTrack.FastTrackStrings.UI.TOOLTIPS.FASTTRACK.INFOCARDOPTS"
msgid ""
"Optimizes the info cards shown on hover.\n"
"\n"
"<b>Performance Impact: <color=#FF8827>Medium</color></b>"
msgstr ""
"优化鼠标悬停显示的信息卡。\n"
"\n"
"<b>性能影响：<color=#FF8827>中</color></b>"

#. PeterHan.FastTrack.FastTrackStrings.UI.TOOLTIPS.FASTTRACK.LOADOPTS
msgctxt "PeterHan.FastTrack.FastTrackStrings.UI.TOOLTIPS.FASTTRACK.LOADOPTS"
msgid ""
"Speeds up loading times.\n"
"\n"
"<b>Performance Impact: <color=#00CC00>Low</color></b>"
msgstr ""
"加快加载速度。\n"
"\n"
"<b>性能影响：<color=#00CC00>低</color></b>"

#. PeterHan.FastTrack.FastTrackStrings.UI.TOOLTIPS.FASTTRACK.LOGICUPDATES
msgctxt "PeterHan.FastTrack.FastTrackStrings.UI.TOOLTIPS.FASTTRACK.LOGICUPDATES"
msgid ""
"Optimizes some buildings to not trigger logic network updates every frame.\n"
"\n"
"<b>Performance Impact: <color=#00CC00>Low</color></b>"
msgstr ""
"优化部分建筑，使其不在每帧触发自动化更新。\n"
"\n"
"<b>性能影响：<color=#00CC00>低</color></b>"

#. PeterHan.FastTrack.FastTrackStrings.UI.TOOLTIPS.FASTTRACK.MESHRENDEREROPTIONS
msgctxt "PeterHan.FastTrack.FastTrackStrings.UI.TOOLTIPS.FASTTRACK.MESHRENDEREROPTIONS"
msgid ""
"Use faster mesh renderers instead of redrawing\n"
"every frame for these graphics.\n"
"\n"
"<b>Performance Impact: <color=#FF8827>Medium</color></b>"
msgstr ""
"对这些图形使用更快的网格渲染器，而不是每帧重绘。\n"
"\n"
"<b>性能影响：<color=#FF8827>中</color></b>"

#. PeterHan.FastTrack.FastTrackStrings.UI.TOOLTIPS.FASTTRACK.MESHRENDERERS.ALL
msgctxt "PeterHan.FastTrack.FastTrackStrings.UI.TOOLTIPS.FASTTRACK.MESHRENDERERS.ALL"
msgid "Use mesh renderers for all graphics"
msgstr "对所有图形使用网格渲染器"

#. PeterHan.FastTrack.FastTrackStrings.UI.TOOLTIPS.FASTTRACK.MESHRENDERERS.EXCEPTTILES
msgctxt "PeterHan.FastTrack.FastTrackStrings.UI.TOOLTIPS.FASTTRACK.MESHRENDERERS.EXCEPTTILES"
msgid "Use mesh renderers for all non-tileable graphics."
msgstr "对所有非砖块的图形使用网格渲染器。"

#. PeterHan.FastTrack.FastTrackStrings.UI.TOOLTIPS.FASTTRACK.MESHRENDERERS.NONE
msgctxt "PeterHan.FastTrack.FastTrackStrings.UI.TOOLTIPS.FASTTRACK.MESHRENDERERS.NONE"
msgid "Do not use mesh renderers for any graphics."
msgstr "不对任何图形使用网格渲染器。"

#. PeterHan.FastTrack.FastTrackStrings.UI.TOOLTIPS.FASTTRACK.METRICS
msgctxt "PeterHan.FastTrack.FastTrackStrings.UI.TOOLTIPS.FASTTRACK.METRICS"
msgid ""
"Logs extra debug information to the game log.\n"
"\n"
"<b>Only use this option if directed to do so by a developer.</b>"
msgstr ""
"将额外的调试信息记录到游戏日志中。\n"
"\n"
"<b>仅在开发者指示时使用此选项。</b>"

#. PeterHan.FastTrack.FastTrackStrings.UI.TOOLTIPS.FASTTRACK.MINIMALKCV
msgctxt "PeterHan.FastTrack.FastTrackStrings.UI.TOOLTIPS.FASTTRACK.MINIMALKCV"
msgid ""
"Reduces memory allocations in most game-wide lists of items.\n"
"\n"
"<b>Performance Impact: <color=#00CC00>Low</color></b>"
msgstr ""
"减少游戏中大部分物品列表的内存分配。\n"
"\n"
"<b>性能影响：<color=#00CC00>低</color></b>"

#. PeterHan.FastTrack.FastTrackStrings.UI.TOOLTIPS.FASTTRACK.MISCOPTS
msgctxt "PeterHan.FastTrack.FastTrackStrings.UI.TOOLTIPS.FASTTRACK.MISCOPTS"
msgid ""
"Optimizes many event and UI handlers.\n"
"\n"
"<b>Performance Impact: <color=#FF8827>Medium</color></b>"
msgstr ""
"优化多个事件和 UI 处理器。\n"
"\n"
"<b>性能影响：<color=#FF8827>中</color></b>"

#. PeterHan.FastTrack.FastTrackStrings.UI.TOOLTIPS.FASTTRACK.NEXTCHOREPRIORITY.DELAY
msgctxt "PeterHan.FastTrack.FastTrackStrings.UI.TOOLTIPS.FASTTRACK.NEXTCHOREPRIORITY.DELAY"
msgid ""
"Delay selecting new chores until Reachability updates.\n"
"\n"
"<color=#FF3300>Longest</color> ponder time, but selects chores more optimally.\n"
"<b>Fast Reachability Checks</b> must also be enabled."
msgstr ""
"延迟选择新任务，直到可达性更新完成。\n"
"\n"
"思考时间<color=#FF3300>最长</color>，但任务选择更为优化。\n"
"必须同时启用<b>快速可达性检测</b>。"

#. PeterHan.FastTrack.FastTrackStrings.UI.TOOLTIPS.FASTTRACK.NEXTCHOREPRIORITY.HIGHER
msgctxt "PeterHan.FastTrack.FastTrackStrings.UI.TOOLTIPS.FASTTRACK.NEXTCHOREPRIORITY.HIGHER"
msgid ""
"Immediately schedule Duplicants for chore selection when a chore completes.\n"
"\n"
"<color=#00CC00>Lowest</color> ponder time, but <color=#FF3300>slowest</color> overall."
msgstr ""
"在任务完成时立即安排复制人选择新任务。\n"
"\n"
"思考时间<color=#00CC00>最短</color>，但整体速度<color=#FF3300>最慢</color>。"

#. PeterHan.FastTrack.FastTrackStrings.UI.TOOLTIPS.FASTTRACK.NEXTCHOREPRIORITY.NORMAL
msgctxt "PeterHan.FastTrack.FastTrackStrings.UI.TOOLTIPS.FASTTRACK.NEXTCHOREPRIORITY.NORMAL"
msgid ""
"Select new chores in normal order.\n"
"\n"
"<color=#00CC00>Fastest</color> overall performance."
msgstr ""
"按正常顺序选择新任务。\n"
"\n"
"整体性能<color=#00CC00>最快</color>。"

#. PeterHan.FastTrack.FastTrackStrings.UI.TOOLTIPS.FASTTRACK.NOBOUNCE
msgctxt "PeterHan.FastTrack.FastTrackStrings.UI.TOOLTIPS.FASTTRACK.NOBOUNCE"
msgid ""
"Disables the bounce effect when new notifications appear.\n"
"\n"
"<b>Performance Impact: <color=#FF8827>Medium</color></b>"
msgstr ""
"禁用新通知出现时的弹跳效果。\n"
"\n"
"<b>性能影响：<color=#FF8827>中</color></b>"

#. PeterHan.FastTrack.FastTrackStrings.UI.TOOLTIPS.FASTTRACK.NOCONVERSATIONS
msgctxt "PeterHan.FastTrack.FastTrackStrings.UI.TOOLTIPS.FASTTRACK.NOCONVERSATIONS"
msgid ""
"Disables all Duplicant thought and speech balloons.\n"
"\n"
"<color=#FF0000>Disables the Mysterious Hermit's special trait.</color>\n"
"\n"
"<b>Performance Impact: <color=#00CC00>Low</color></b>"
msgstr ""
"禁用所有复制人的思绪和对话气泡。\n"
"<color=#FF0000>禁用神秘隐士的故事特性。</color>\n"
"<b>性能影响：<color=#00CC00>低</color></b>"

#. PeterHan.FastTrack.FastTrackStrings.UI.TOOLTIPS.FASTTRACK.NODISEASE
msgctxt "PeterHan.FastTrack.FastTrackStrings.UI.TOOLTIPS.FASTTRACK.NODISEASE"
msgid ""
"Completely disable the entire disease system.\n"
"• Sick Bay and Disease Clinic cannot be built or used\n"
"• No new diseases can be contracted\n"
"• Existing diseases will be immediately removed\n"
"• All germs will be removed from pipes and buildings\n"
"<i>Not compatible with mods: Diseases Restored, Diseases Expanded</i>\n"
"\n"
"<b>Performance Impact: <color=#FF8827>Medium</color></b>"
msgstr ""
"完全禁用整个疾病系统。\n"
"• 无法建造或使用医务室和疾病诊所\n"
"• 无法感染新疾病\n"
"• 现有疾病将立即清除\n"
"• 管道和建筑中的所有病菌将被移除\n"
"与 Mod “Diseases Restored” 和 “Diseases Expanded” 不兼容\n"
"\n"
"<b>性能影响：<color=#FF8827>中</color></b>"

#. PeterHan.FastTrack.FastTrackStrings.UI.TOOLTIPS.FASTTRACK.NOPLACEREASING
msgctxt "PeterHan.FastTrack.FastTrackStrings.UI.TOOLTIPS.FASTTRACK.NOPLACEREASING"
msgid ""
"Disables the animation which appears when placing\n"
"errands like Dig or Mop.\n"
"\n"
"<b>Performance Impact: <color=#00CC00>Low</color></b>"
msgstr ""
"禁用在放置挖掘或清理等任务时出现的动画。\n"
"\n"
"<b>性能影响：<color=#00CC00>低</color></b>"

#. PeterHan.FastTrack.FastTrackStrings.UI.TOOLTIPS.FASTTRACK.NOREPORTS
msgctxt "PeterHan.FastTrack.FastTrackStrings.UI.TOOLTIPS.FASTTRACK.NOREPORTS"
msgid ""
"Disables colony reports completely.\n"
"<color=#FF0000>Disabling will prevent some achievements from being unlocked</color>\n"
"\n"
"<b>Performance Impact: <color=#FF8827>Medium</color></b>"
msgstr ""
"完全禁用殖民地报告。\n"
"<color=#FF0000>关闭后将导致部分成就无法解锁</color>\n"
"\n"
"<b>性能影响：<color=#FF8827>中</color></b>"

#. PeterHan.FastTrack.FastTrackStrings.UI.TOOLTIPS.FASTTRACK.NOSPLASH
msgctxt "PeterHan.FastTrack.FastTrackStrings.UI.TOOLTIPS.FASTTRACK.NOSPLASH"
msgid ""
"Disables most puff, splash, and breath animations.\n"
"\n"
"<b>Performance Impact: <color=#00CC00>Low</color></b>"
msgstr ""
"禁用大部分喷气、飞溅和呼吸动画。\n"
"\n"
"<b>性能影响：<color=#00CC00>低</color></b>"

#. PeterHan.FastTrack.FastTrackStrings.UI.TOOLTIPS.FASTTRACK.NOTILEDECOR
msgctxt "PeterHan.FastTrack.FastTrackStrings.UI.TOOLTIPS.FASTTRACK.NOTILEDECOR"
msgid ""
"Disables all ornaments and edges on constructed tiles.\n"
"<i>Not compatible with mods: True Tiles</i>\n"
"\n"
"<b>Performance Impact: <color=#00CC00>Low</color></b>"
msgstr ""
"禁用所有建造方块的装饰和边缘。\n"
"<i>与 Mod “True Tiles” 不兼容</i>\n"
"\n"
"<b>性能影响：<color=#00CC00>低</color></b>"

#. PeterHan.FastTrack.FastTrackStrings.UI.TOOLTIPS.FASTTRACK.OPTIMIZEDIALOGS
msgctxt "PeterHan.FastTrack.FastTrackStrings.UI.TOOLTIPS.FASTTRACK.OPTIMIZEDIALOGS"
msgid ""
"Speeds up a variety of dialog boxes.\n"
"\n"
"<b>Performance Impact: <color=#00CC00>Low</color></b>"
msgstr ""
"加快多种对话框的显示速度。\n"
"\n"
"<b>性能影响：<color=#00CC00>低</color></b>"

#. PeterHan.FastTrack.FastTrackStrings.UI.TOOLTIPS.FASTTRACK.PARALLELINVENTORY
msgctxt "PeterHan.FastTrack.FastTrackStrings.UI.TOOLTIPS.FASTTRACK.PARALLELINVENTORY"
msgid ""
"Compiles the item quantites in the Resources panel on a non-blocking thread.\n"
"\n"
"<b>Performance Impact: <color=#FF8827>Medium</color></b>"
msgstr ""
"在非阻塞线程中编译资源面板中的物品数量。\n"
"\n"
"<b>性能影响：<color=#FF8827>中</color></b>"

#. PeterHan.FastTrack.FastTrackStrings.UI.TOOLTIPS.FASTTRACK.PICKUPOPTS
msgctxt "PeterHan.FastTrack.FastTrackStrings.UI.TOOLTIPS.FASTTRACK.PICKUPOPTS"
msgid ""
"Dramatically speed up scanning for items to store or supply.\n"
"\n"
"<b>Performance Impact: <color=#FF8827>Medium</color></b>"
msgstr ""
"显著加快物品存储或供应的扫描速度。\n"
"\n"
"<b>性能影响：<color=#FF8827>中</color></b>"

#. PeterHan.FastTrack.FastTrackStrings.UI.TOOLTIPS.FASTTRACK.PIPEANIM.FULL
msgctxt "PeterHan.FastTrack.FastTrackStrings.UI.TOOLTIPS.FASTTRACK.PIPEANIM.FULL"
msgid "Pipe animation quality is unchanged from the base game."
msgstr "管道动画质量与原版游戏保持一致。"

#. PeterHan.FastTrack.FastTrackStrings.UI.TOOLTIPS.FASTTRACK.PIPEANIM.MINIMAL
msgctxt "PeterHan.FastTrack.FastTrackStrings.UI.TOOLTIPS.FASTTRACK.PIPEANIM.MINIMAL"
msgid "Pipe animations are disabled outside the Liquid or Gas overlay."
msgstr "在液体或气体视图之外，管道动画被禁用。"

#. PeterHan.FastTrack.FastTrackStrings.UI.TOOLTIPS.FASTTRACK.PIPEANIM.REDUCED
msgctxt "PeterHan.FastTrack.FastTrackStrings.UI.TOOLTIPS.FASTTRACK.PIPEANIM.REDUCED"
msgid "Pipe animations update slower when outside the Liquid or Gas overlay."
msgstr "在液体或气体覆视图之外，管道动画更新速度较慢。"

#. PeterHan.FastTrack.FastTrackStrings.UI.TOOLTIPS.FASTTRACK.RADIATIONOPTS
msgctxt "PeterHan.FastTrack.FastTrackStrings.UI.TOOLTIPS.FASTTRACK.RADIATIONOPTS"
msgid ""
"Speeds up radiation calculations.\n"
"\n"
"<b>Performance Impact: <color=#00CC00>Low</color></b>"
msgstr ""
"加快辐射计算速度。\n"
"\n"
"<b>性能影响：<color=#00CC00>低</color></b>"

#. PeterHan.FastTrack.FastTrackStrings.UI.TOOLTIPS.FASTTRACK.REDUCECOLONYTRACKING
msgctxt "PeterHan.FastTrack.FastTrackStrings.UI.TOOLTIPS.FASTTRACK.REDUCECOLONYTRACKING"
msgid ""
"Reduces the update rate of Colony Diagnostics.\n"
"<i>Some notifications may take longer to trigger</i>\n"
"\n"
"<b>Performance Impact: <color=#00CC00>Low</color></b>"
msgstr ""
"降低殖民地诊断的更新频率。\n"
"部分通知触发可能会延迟\n"
"\n"
"<b>性能影响：<color=#00CC00>低</color></b>"

#. PeterHan.FastTrack.FastTrackStrings.UI.TOOLTIPS.FASTTRACK.REDUCECRITTERIDLEMOVE
msgctxt "PeterHan.FastTrack.FastTrackStrings.UI.TOOLTIPS.FASTTRACK.REDUCECRITTERIDLEMOVE"
msgid ""
"Reduces amount of idle movement of critters that are currently not visible on the screen.\n"
"\n"
"<b>Performance Impact: <color=#00CC00>Low</color></b>"
msgstr ""
"减少当前屏幕上不可见小动物的闲置移动量。\n"
"\n"
"<b>性能影响：<color=#00CC00>低</color></b>"

#. PeterHan.FastTrack.FastTrackStrings.UI.TOOLTIPS.FASTTRACK.REDUCEDUPLICANTIDLEMOVE
msgctxt "PeterHan.FastTrack.FastTrackStrings.UI.TOOLTIPS.FASTTRACK.REDUCEDUPLICANTIDLEMOVE"
msgid ""
"Reduces amount of idle movement of duplicants that are currently not visible on the screen.\n"
"\n"
"<b>Performance Impact: <color=#00CC00>Low</color></b>"
msgstr ""
"减少当前屏幕上不可见复制人的闲置移动量。\n"
"\n"
"<b>性能影响：<color=#00CC00>低</color></b>"

#. PeterHan.FastTrack.FastTrackStrings.UI.TOOLTIPS.FASTTRACK.REDUCESOUNDUPDATES
msgctxt "PeterHan.FastTrack.FastTrackStrings.UI.TOOLTIPS.FASTTRACK.REDUCESOUNDUPDATES"
msgid ""
"Reduces the frequency of sound location updates.\n"
"\n"
"<b>Performance Impact: <color=#00CC00>Low</color></b>"
msgstr ""
"减少声音位置更新的频率。\n"
"\n"
"<b>性能影响：<color=#00CC00>低</color></b>"

#. PeterHan.FastTrack.FastTrackStrings.UI.TOOLTIPS.FASTTRACK.REDUCETILEUPDATES
msgctxt "PeterHan.FastTrack.FastTrackStrings.UI.TOOLTIPS.FASTTRACK.REDUCETILEUPDATES"
msgid ""
"Multi-threads updates to most tile textures.\n"
"\n"
"<b>Performance Impact: <color=#FF3300>High</color></b>"
msgstr ""
"将大部分砖块纹理的更新操作多线程处理。\n"
"\n"
"<b>性能影响：<color=#FF3300>高</color></b>"

#. PeterHan.FastTrack.FastTrackStrings.UI.TOOLTIPS.FASTTRACK.RENDERTICKS
msgctxt "PeterHan.FastTrack.FastTrackStrings.UI.TOOLTIPS.FASTTRACK.RENDERTICKS"
msgid ""
"Optimizes several renderers that run every frame.\n"
"<i>Some visual artifacts may appear with no effect on gameplay</i>\n"
"\n"
"<b>Performance Impact: <color=#FF8827>Medium</color></b>"
msgstr ""
"优化多个每帧运行的渲染器。\n"
"<i>可能出现一些视觉瑕疵，但不会影响游戏玩法</i>\n"
"\n"
"<b>性能影响：<color=#FF8827>中</color></b>"

#. PeterHan.FastTrack.FastTrackStrings.UI.TOOLTIPS.FASTTRACK.SENSOROPTS
msgctxt "PeterHan.FastTrack.FastTrackStrings.UI.TOOLTIPS.FASTTRACK.SENSOROPTS"
msgid ""
"Only check for locations to Idle, Mingle, or Balloon Artist when necessary.\n"
"\n"
"<b>Performance Impact: <color=#00CC00>Low</color></b>"
msgstr ""
"仅在必要时检查闲置、社交或气球艺术家的位置。\n"
"\n"
"<b>性能影响：<color=#00CC00>低</color></b>"

#. PeterHan.FastTrack.FastTrackStrings.UI.TOOLTIPS.FASTTRACK.SIDESCREENOPTS
msgctxt "PeterHan.FastTrack.FastTrackStrings.UI.TOOLTIPS.FASTTRACK.SIDESCREENOPTS"
msgid ""
"Optimizes the informational side screens.\n"
"\n"
"<b>Performance Impact: <color=#FF8827>Medium</color></b>"
msgstr ""
"优化信息侧屏显示。\n"
"\n"
"<b>性能影响：<color=#FF8827>中</color></b>"

#. PeterHan.FastTrack.FastTrackStrings.UI.TOOLTIPS.FASTTRACK.THREATOVERCROWDING
msgctxt "PeterHan.FastTrack.FastTrackStrings.UI.TOOLTIPS.FASTTRACK.THREATOVERCROWDING"
msgid ""
"Optimizes critter Threat and Overcrowding monitors.\n"
"<i>May conflict with mods that add new critters</i>\n"
"\n"
"<b>Performance Impact: <color=#00CC00>Low</color></b>"
msgstr ""
"优化生物的威胁和过度拥挤监控。\n"
"<i>可能与添加新生物的 Mod 冲突</i>\n"
"\n"
"<b>性能影响：<color=#00CC00>低</color></b>"

#. PeterHan.FastTrack.FastTrackStrings.UI.TOOLTIPS.FASTTRACK.TUTORIALS.ALL
msgctxt "PeterHan.FastTrack.FastTrackStrings.UI.TOOLTIPS.FASTTRACK.TUTORIALS.ALL"
msgid "All tutorial messages are shown when they would normally appear."
msgstr "所有教程提示信息都会按正常出现显示。"

#. PeterHan.FastTrack.FastTrackStrings.UI.TOOLTIPS.FASTTRACK.TUTORIALS.OFF
msgctxt "PeterHan.FastTrack.FastTrackStrings.UI.TOOLTIPS.FASTTRACK.TUTORIALS.OFF"
msgid ""
"Tutorial messages and these warnings will be disabled:\n"
"• Insufficient Oxygen Generation\n"
"• Colony requires a food source\n"
"• Long Commutes\n"
"• No Outhouse built\n"
"• No Wash Basin built\n"
"• No Oxygen Generator built\n"
"• Unrefrigerated Food\n"
"• No Sick Bay built\n"
"\n"
"<i>Keep a careful eye on your colony...</i>"
msgstr ""
"教程提示信息和以下警告将被禁用：\n"
"• 氧气生成不足\n"
"• 殖民地需要食物来源\n"
"• 通勤时间过长\n"
"• 未建造厕所\n"
"• 未建造洗手台\n"
"• 未建造氧气生产装置\n"
"• 食物未冷藏\n"
"• 未建造医务室\n"
"\n"
"<i>请密切关注你的殖民地……</i>"

#. PeterHan.FastTrack.FastTrackStrings.UI.TOOLTIPS.FASTTRACK.TUTORIALS.WARNINGS
msgctxt "PeterHan.FastTrack.FastTrackStrings.UI.TOOLTIPS.FASTTRACK.TUTORIALS.WARNINGS"
msgid ""
"Tutorial messages are disabled, but warnings such as\n"
"<b>Insufficient Oxygen Generation</b> will still appear."
msgstr ""
"教程提示信息已被禁用，但诸如\n"
"<b>氧气生成不足</b>等警告仍会显示。"

#. PeterHan.FastTrack.FastTrackStrings.UI.TOOLTIPS.FASTTRACK.UNSTACKLIGHTS
msgctxt "PeterHan.FastTrack.FastTrackStrings.UI.TOOLTIPS.FASTTRACK.UNSTACKLIGHTS"
msgid ""
"Reduces the visual effects shown when many light sources are stacked.\n"
"Intended for ranching critters like Shine Bugs.\n"
"\n"
"<b>Performance Impact: <color=#00CC00>Low</color></b>"
msgstr ""
"减少多个光源叠加时显示的视觉效果。\n"
"适用于饲养如荧光虫等生物。\n"
"\n"
"<b>性能影响：<color=#00CC00>低</color></b>"

#. PeterHan.FastTrack.FastTrackStrings.UI.TOOLTIPS.FASTTRACK.VERINWATERMARK
msgctxt "PeterHan.FastTrack.FastTrackStrings.UI.TOOLTIPS.FASTTRACK.VERINWATERMARK"
msgid ""
"Show the Fast Track version in the build watermark.\n"
"\n"
"<i>No performance impact</i>"
msgstr ""
"在水印中显示 Fast Track 版本。\n"
"<i>不影响性能</i>"

#. PeterHan.FastTrack.FastTrackStrings.UI.TOOLTIPS.FASTTRACK.VIRTUALSCROLL
msgctxt "PeterHan.FastTrack.FastTrackStrings.UI.TOOLTIPS.FASTTRACK.VIRTUALSCROLL"
msgid ""
"Improves the speed of scrolling menus.\n"
"\n"
"<b>Performance Impact: <color=#FF8827>Medium</color></b>"
msgstr ""
"提升滚动菜单的速度。\n"
"\n"
"<b>性能影响：<color=#FF8827>中</color></b>"

#. PeterHan.FastTrack.FastTrackStrings.UI.TOOLTIPS.FASTTRACK.WATERMARK.HIDE
msgctxt "PeterHan.FastTrack.FastTrackStrings.UI.TOOLTIPS.FASTTRACK.WATERMARK.HIDE"
msgid "Show only the current game version in the build watermark."
msgstr "在水印中仅显示当前游戏版本。"

#. PeterHan.FastTrack.FastTrackStrings.UI.TOOLTIPS.FASTTRACK.WATERMARK.OFF
msgctxt "PeterHan.FastTrack.FastTrackStrings.UI.TOOLTIPS.FASTTRACK.WATERMARK.OFF"
msgid "Hide the build watermark completely in-game."
msgstr "在游戏中完全隐藏水印。"

#. PeterHan.FastTrack.FastTrackStrings.UI.TOOLTIPS.FASTTRACK.WATERMARK.SHOW
msgctxt "PeterHan.FastTrack.FastTrackStrings.UI.TOOLTIPS.FASTTRACK.WATERMARK.SHOW"
msgid "Show the current Fast Track version and game version in the build watermark."
msgstr "在水印中显示当前 Fast Track 版本和游戏版本。"
